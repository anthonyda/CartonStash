<?xml version="1.0" encoding="utf-8"?>
<!-- Package details (spec 005). Hosted by each list page; adaptive layout is the page's job. -->
<UserControl
    x:Class="CartonStash.App.Controls.PackageDetailsPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CartonStash.App.Controls"
    xmlns:models="using:CartonStash.Core.Models">

    <Grid
        Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: name, publisher, close (R4.1) -->
        <Grid Padding="20,16,12,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- 005 R5.1 -->
            <controls:PackageIcon
                Width="48"
                Height="48"
                VerticalAlignment="Top"
                Row="{x:Bind ViewModel.Row, Mode=OneWay}" />
            <StackPanel Grid.Column="1">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.Row.Name, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.Details.Publisher, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HasPublisher, Mode=OneWay}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    IsTextSelectionEnabled="True"
                    Text="{x:Bind ViewModel.Row.Id, Mode=OneWay}" />
            </StackPanel>
            <Button
                Grid.Column="2"
                VerticalAlignment="Top"
                AutomationProperties.Name="Close details"
                Command="{x:Bind ViewModel.CloseCommand, Mode=OneWay}"
                ToolTipService.ToolTip="Close (Esc)">
                <FontIcon FontSize="12" Glyph="&#xE711;" />
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="20,0,20,20">
            <StackPanel Spacing="16">
                <!-- R3.1: same actions and progress as the row -->
                <controls:PackageActionsView HorizontalAlignment="Left" Row="{x:Bind ViewModel.Row, Mode=OneWay}" />

                <ProgressBar
                    AutomationProperties.Name="Loading details"
                    IsIndeterminate="True"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

                <!-- R1.5 -->
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.PartialNote, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasPartialNote, Mode=OneWay}" />
                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Severity="Warning" />

                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.Row.Package.IsInstalled, Mode=OneWay}">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Installed version" />
                    <!-- 002 R7 -->
                    <controls:VersionBadge HorizontalAlignment="Left" Row="{x:Bind ViewModel.Row, Mode=OneWay}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.Row.VersionStatusText, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!-- R1.2 -->
                <TextBlock
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind ViewModel.Details.ShortDescription, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasShortDescription, Mode=OneWay}" />
                <TextBlock
                    IsTextSelectionEnabled="True"
                    Text="{x:Bind ViewModel.Details.Description, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasDescription, Mode=OneWay}" />

                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasLicense, Mode=OneWay}">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="License" />
                    <TextBlock IsTextSelectionEnabled="True" Text="{x:Bind ViewModel.Details.License, Mode=OneWay}" TextWrapping="Wrap" />
                    <HyperlinkButton
                        Padding="0"
                        AutomationProperties.Name="License (opens browser)"
                        Click="Link_Click"
                        Content="Read the license"
                        Tag="{x:Bind ViewModel.LicenseUri, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasLicenseUri, Mode=OneWay}" />
                </StackPanel>

                <!-- R1.3: links open the default browser -->
                <StackPanel Spacing="4">
                    <HyperlinkButton
                        Padding="0"
                        AutomationProperties.Name="Homepage (opens browser)"
                        Click="Link_Click"
                        Content="Homepage"
                        Tag="{x:Bind ViewModel.HomepageUri, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasHomepageUri, Mode=OneWay}" />
                    <HyperlinkButton
                        Padding="0"
                        AutomationProperties.Name="Publisher website (opens browser)"
                        Click="Link_Click"
                        Content="Publisher website"
                        Tag="{x:Bind ViewModel.PublisherUri, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasPublisherUri, Mode=OneWay}" />
                    <HyperlinkButton
                        Padding="0"
                        AutomationProperties.Name="Support (opens browser)"
                        Click="Link_Click"
                        Content="Support"
                        Tag="{x:Bind ViewModel.SupportUri, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasSupportUri, Mode=OneWay}" />
                    <HyperlinkButton
                        Padding="0"
                        AutomationProperties.Name="Privacy policy (opens browser)"
                        Click="Link_Click"
                        Content="Privacy policy"
                        Tag="{x:Bind ViewModel.PrivacyUri, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasPrivacyUri, Mode=OneWay}" />
                </StackPanel>

                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasTags, Mode=OneWay}">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Tags" />
                    <TextBlock Text="{x:Bind ViewModel.TagsText, Mode=OneWay}" TextWrapping="Wrap" />
                </StackPanel>

                <!-- R2.2, spec 012 -->
                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ShowReleaseNotesSection, Mode=OneWay}">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Release notes" />
                    <!-- 012 R2.4: title, date, and where the notes come from -->
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.GitHubNotesHeader, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.NotesFromGitHub, Mode=OneWay}" />
                    <!-- 012 R1, R2.4 to R2.8 -->
                    <controls:NotesView Document="{x:Bind ViewModel.ReleaseNotes, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasReleaseNotes, Mode=OneWay}" />
                    <!-- 012 R2.1, R2.2: only on the user's press -->
                    <Button
                        AutomationProperties.Name="Show release notes from GitHub"
                        Command="{x:Bind ViewModel.LoadGitHubNotesCommand, Mode=OneWay}"
                        Content="Show notes from GitHub"
                        Visibility="{x:Bind ViewModel.CanShowGitHubNotes, Mode=OneWay}" />
                    <!-- 012 R2.3, R2.11: one status line, loading then the outcome -->
                    <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.HasGitHubNotesStatus, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressRing
                            Width="16"
                            Height="16"
                            VerticalAlignment="Top"
                            AutomationProperties.AccessibilityView="Raw"
                            IsActive="{x:Bind ViewModel.IsLoadingGitHubNotes, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsLoadingGitHubNotes, Mode=OneWay}" />
                        <FontIcon
                            VerticalAlignment="Top"
                            AutomationProperties.AccessibilityView="Raw"
                            FontSize="16"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE946;"
                            Visibility="{x:Bind ViewModel.HasGitHubNotesMessage, Mode=OneWay}" />
                        <TextBlock
                            x:Name="GitHubStatusText"
                            Grid.Column="1"
                            AutomationProperties.LiveSetting="Polite"
                            Text="{x:Bind ViewModel.GitHubNotesStatus, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <HyperlinkButton
                            Grid.Column="2"
                            Padding="0"
                            VerticalAlignment="Top"
                            AutomationProperties.Name="Retry loading the notes from GitHub"
                            Command="{x:Bind ViewModel.LoadGitHubNotesCommand, Mode=OneWay}"
                            Content="Retry"
                            Visibility="{x:Bind ViewModel.CanRetryGitHubNotes, Mode=OneWay}" />
                    </Grid>
                </StackPanel>
                <HyperlinkButton
                    Padding="0"
                    AutomationProperties.Name="Release notes (opens browser)"
                    Click="Link_Click"
                    Content="Release notes online"
                    Tag="{x:Bind ViewModel.ReleaseNotesUri, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HasReleaseNotesUri, Mode=OneWay}" />

                <!-- R2.1; 014 R1: one list, one button for the selected version -->
                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasVersions, Mode=OneWay}">
                    <TextBlock
                        x:Name="VersionsTitle"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Available versions" />
                    <TextBlock
                        Text="{x:Bind ViewModel.VersionsText, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.ShowVersionsText, Mode=OneWay}" />
                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.OffersVersionActions, Mode=OneWay}">
                        <!-- No scrolling of its own: the pane scrolls (design, UI). -->
                        <ListView
                            x:Name="VersionList"
                            AutomationProperties.LabeledBy="{x:Bind VersionsTitle}"
                            ItemsSource="{x:Bind ViewModel.ShownVersions, Mode=OneWay}"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollMode="Disabled"
                            SelectionChanged="VersionList_SelectionChanged"
                            SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:VersionItem">
                                    <TextBlock Text="{x:Bind Label}" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button
                                AutomationProperties.Name="{x:Bind ViewModel.VersionActionName, Mode=OneWay}"
                                Command="{x:Bind ViewModel.RunVersionCommand, Mode=OneWay}"
                                Content="{x:Bind ViewModel.VersionActionText, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.ShowVersionAction, Mode=OneWay}" />
                            <HyperlinkButton
                                Command="{x:Bind ViewModel.ShowAllVersionsCommand, Mode=OneWay}"
                                Content="Show all versions"
                                Visibility="{x:Bind ViewModel.HasMoreVersions, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
