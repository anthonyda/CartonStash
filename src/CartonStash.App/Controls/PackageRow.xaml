<?xml version="1.0" encoding="utf-8"?>
<!-- One package row, shared by Search, Installed and Updates (002 T5). On narrow rows the versions move under the name. -->
<UserControl
    x:Class="CartonStash.App.Controls.PackageRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CartonStash.App.Controls"
    xmlns:ui="using:CartonStash.App">

    <Grid
        x:Name="Layout"
        Padding="0,8"
        ColumnSpacing="16"
        SizeChanged="Layout_SizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="32" />
            <ColumnDefinition Width="*" MinWidth="80" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" MinWidth="96" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 005 R5.1: WinGet's icon, or a package glyph -->
        <controls:PackageIcon
            Grid.RowSpan="2"
            Width="32"
            Height="32"
            VerticalAlignment="Center"
            Row="{x:Bind Row, Mode=OneWay}" />

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind Row.Name, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind Row.Id, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
        </StackPanel>

        <StackPanel
            x:Name="Versions"
            Grid.Column="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Spacing="4">
            <StackPanel
                x:Name="Badges"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <!-- 001 R2.1 -->
                <Border
                    Padding="6,1"
                    Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                    BorderBrush="{ThemeResource SystemFillColorSuccessBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="{x:Bind Row.Package.IsInstalled, Mode=OneWay}">
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="NoWrap">
                        <Run Text="Installed" />
                        <Run Text="{x:Bind Row.Package.InstalledVersion, Mode=OneWay}" />
                    </TextBlock>
                </Border>
                <!-- 001 R2.2, 002 R3.2 -->
                <Border
                    Padding="6,1"
                    Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                    BorderBrush="{ThemeResource SystemFillColorAttentionBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="{x:Bind Row.Package.HasUpdate, Mode=OneWay}">
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Update available" TextWrapping="NoWrap" />
                </Border>
                <TextBlock Text="{x:Bind Row.Package.AvailableVersion, Mode=OneWay}" TextWrapping="NoWrap" />
            </StackPanel>
            <!-- 002 R1.2, R3.1 -->
            <TextBlock
                x:Name="SourceLabel"
                HorizontalAlignment="Right"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="{x:Bind Row.Package.SourceText, Mode=OneWay}"
                TextWrapping="NoWrap" />
        </StackPanel>

        <controls:PackageActionsView
            Grid.RowSpan="2"
            Grid.Column="3"
            Row="{x:Bind Row, Mode=OneWay}" />
    </Grid>
</UserControl>
