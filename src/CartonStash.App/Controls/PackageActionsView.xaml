<?xml version="1.0" encoding="utf-8"?>
<!-- Install / Update / Uninstall buttons, or the running operation's progress (003 R1.1, R2.1, R3.1, R3.2). -->
<UserControl
    x:Class="CartonStash.App.Controls.PackageActionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:CartonStash.App">

    <Grid>
        <StackPanel
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="8"
            Visibility="{x:Bind ui:Ui.Collapsed(Row.IsBusy), Mode=OneWay}">
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind Row.ResultText, Mode=OneWay}"
                Visibility="{x:Bind Row.HasResult, Mode=OneWay}" />
            <Button
                AutomationProperties.Name="{x:Bind ui:Ui.Format('Install {0}', Row.Name), Mode=OneWay}"
                Command="{x:Bind Row.InstallCommand, Mode=OneWay}"
                Content="Install"
                Style="{StaticResource AccentButtonStyle}"
                Visibility="{x:Bind ui:Ui.VisibleIfNot(Row.ShowInstall, OffersScopeChoice), Mode=OneWay}" />
            <!-- 015 R1.1, R1.4, R1.6, Q3: Install keeps the setting; the menu chooses a scope for this install -->
            <SplitButton
                AutomationProperties.Name="{x:Bind ui:Ui.Format('Install {0}', Row.Name), Mode=OneWay}"
                Command="{x:Bind Row.InstallCommand, Mode=OneWay}"
                Content="Install"
                Visibility="{x:Bind ui:Ui.VisibleIfBoth(Row.ShowInstall, OffersScopeChoice), Mode=OneWay}">
                <SplitButton.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem
                            AutomationProperties.Name="{x:Bind ui:Ui.Format('Install {0} for all users', Row.Name), Mode=OneWay}"
                            Command="{x:Bind InstallForAllUsersCommand, Mode=OneWay}"
                            Text="Install for all users (Windows may ask for permission)" />
                        <MenuFlyoutItem
                            AutomationProperties.Name="{x:Bind ui:Ui.Format('Install {0} for the current user', Row.Name), Mode=OneWay}"
                            Command="{x:Bind InstallForCurrentUserCommand, Mode=OneWay}"
                            Text="Install for the current user" />
                    </MenuFlyout>
                </SplitButton.Flyout>
            </SplitButton>
            <Button
                AutomationProperties.Name="{x:Bind ui:Ui.Format('Update {0}', Row.Name), Mode=OneWay}"
                Command="{x:Bind Row.UpdateCommand, Mode=OneWay}"
                Content="Update"
                Style="{StaticResource AccentButtonStyle}"
                Visibility="{x:Bind Row.ShowUpdate, Mode=OneWay}" />
            <!-- 017 R1.3 -->
            <Button
                AutomationProperties.Name="{x:Bind ui:Ui.Format('Retry {0} as administrator', Row.Name), Mode=OneWay}"
                Command="{x:Bind Row.RetryAsAdminCommand, Mode=OneWay}"
                Content="Retry as administrator"
                Style="{StaticResource AccentButtonStyle}"
                Visibility="{x:Bind Row.ShowRetryAsAdmin, Mode=OneWay}" />
            <!-- 004 R6.2, R6.3: App Installer's update waits for the app to restart -->
            <Button
                AutomationProperties.Name="{x:Bind ui:Ui.Format('Restart CartonStash to finish updating {0}', Row.Name), Mode=OneWay}"
                Command="{x:Bind Row.RestartCommand, Mode=OneWay}"
                Content="Restart CartonStash"
                Style="{StaticResource AccentButtonStyle}"
                Visibility="{x:Bind Row.ShowRestart, Mode=OneWay}" />
            <Button
                AutomationProperties.Name="{x:Bind ui:Ui.Format('Uninstall {0}', Row.Name), Mode=OneWay}"
                Command="{x:Bind Row.UninstallCommand, Mode=OneWay}"
                Content="Uninstall"
                Visibility="{x:Bind Row.ShowUninstall, Mode=OneWay}" />
            <!-- 010 R5.1, R5.5 -->
            <Button
                AutomationProperties.Name="{x:Bind ui:Ui.Format('Exclude {0} from update checks', Row.Name), Mode=OneWay}"
                Command="{x:Bind Row.ExcludeCommand, Mode=OneWay}"
                Content="Exclude"
                ToolTipService.ToolTip="{x:Bind ui:Ui.Format('Exclude {0} from update checks', Row.Name), Mode=OneWay}"
                Visibility="{x:Bind Row.ShowExclude, Mode=OneWay}" />
            <Button
                AutomationProperties.Name="{x:Bind ui:Ui.Format('Include {0} in update checks again', Row.Name), Mode=OneWay}"
                Command="{x:Bind Row.IncludeAgainCommand, Mode=OneWay}"
                Content="Include again"
                Visibility="{x:Bind Row.ShowIncludeAgain, Mode=OneWay}" />
        </StackPanel>

        <StackPanel
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="8"
            Visibility="{x:Bind Row.IsBusy, Mode=OneWay}">
            <ProgressRing
                Width="20"
                Height="20"
                AutomationProperties.Name="{x:Bind Row.Operation.StatusText, Mode=OneWay}"
                IsIndeterminate="{x:Bind Row.Operation.IsIndeterminate, Mode=OneWay}"
                Maximum="100"
                Value="{x:Bind Row.Operation.ProgressValue, Mode=OneWay}" />
            <!-- 018 R1.2: Windows' permission prompt is waiting -->
            <FontIcon
                VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                FontSize="14"
                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                Glyph="&#xEA18;"
                Visibility="{x:Bind Row.Operation.IsWaitingForPermission, Mode=OneWay}" />
            <TextBlock
                VerticalAlignment="Center"
                AutomationProperties.LiveSetting="Polite"
                Text="{x:Bind Row.Operation.StatusText, Mode=OneWay}" />
            <Button
                AutomationProperties.Name="{x:Bind ui:Ui.Format('Cancel {0}', Row.Name), Mode=OneWay}"
                Command="{x:Bind Row.Operation.CancelCommand, Mode=OneWay}"
                ToolTipService.ToolTip="Cancel"
                Visibility="{x:Bind Row.Operation.CanCancel, Mode=OneWay}">
                <FontIcon FontSize="12" Glyph="&#xE711;" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
