<?xml version="1.0" encoding="utf-8"?>
<!-- Formatted release notes (spec 012): WinGet's text or GitHub's notes. Collapses to about 10 lines (R1.6, R2.8). -->
<UserControl
    x:Class="CartonStash.App.Controls.NotesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CartonStash.App.Controls">

    <!-- Brushes come through ThemeResource styles, so they follow the app's own light, dark or high-contrast theme. -->
    <UserControl.Resources>
        <Style x:Key="QuoteStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="Padding" Value="12,0,0,0" />
        </Style>
        <Style x:Key="CodeStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,6,8,6" />
        </Style>
        <Style x:Key="TableStyle" TargetType="Grid">
            <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1,1,0,0" />
        </Style>
        <Style x:Key="CellStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="8,4,8,4" />
        </Style>
        <Style x:Key="RuleStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="0,4,0,4" />
        </Style>
    </UserControl.Resources>

    <StackPanel Spacing="4">
        <controls:CollapsingPanel x:Name="Viewport">
            <StackPanel x:Name="Blocks" Spacing="8" />
        </controls:CollapsingPanel>
        <HyperlinkButton
            x:Name="Toggle"
            Padding="0"
            Click="Toggle_Click"
            Content="Show more"
            Visibility="Collapsed" />
    </StackPanel>
</UserControl>
