<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CartonStash.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CartonStash.App.Controls"
    xmlns:models="using:CartonStash.Core.Models"
    xmlns:ui="using:CartonStash.App"
    Title="CartonStash">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            x:Name="AppTitleBar"
            Padding="12,0,0,0"
            Orientation="Horizontal"
            Spacing="10">
            <Image
                Width="18"
                Height="18"
                VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                Source="ms-appx:///Assets/AppIcon.svg" />
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="CartonStash" />
        </StackPanel>

        <!-- 002 R4.1: left navigation. Pages are cached for the session (R4.2). -->
        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="True"
            IsSettingsVisible="True"
            ItemInvoked="Nav_ItemInvoked"
            OpenPaneLength="220"
            DisplayModeChanged="Nav_DisplayModeChanged"
            PaneDisplayMode="Auto"
            SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Search" Tag="search">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Installed" Tag="installed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7B8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!-- 004 R4.1 -->
                <NavigationViewItem Content="Updates" Tag="updates">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE777;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge
                            AutomationProperties.Name="Available updates"
                            Visibility="{x:Bind Shell.HasUpdates, Mode=OneWay}"
                            Value="{x:Bind Shell.UpdatesCount, Mode=OneWay}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <!-- 003: opens the Activity pane instead of navigating (see Nav_SelectionChanged) -->
                <NavigationViewItem
                    Content="{x:Bind Shell.ActivityText, Mode=OneWay}"
                    Tag="activity">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <SplitView
                x:Name="ActivitySplit"
                DisplayMode="Overlay"
                OpenPaneLength="400"
                PaneBackground="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                PanePlacement="Right">
                <SplitView.Pane>
                    <Grid Padding="16" RowSpacing="8">
                        <Grid.Resources>
                            <!-- 009 R4.4, R4.10: dividers are headings with the count in words; Failed has its own word and color -->
                            <DataTemplate x:Key="ActivityHeaderTemplate" x:DataType="models:ActivityHeader">
                                <Grid
                                    Margin="0,8,0,0"
                                    AutomationProperties.HeadingLevel="Level3"
                                    AutomationProperties.Name="{x:Bind AccessibleName}"
                                    ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}">
                                        <Run FontWeight="SemiBold" Text="{x:Bind Name}" />
                                        <Run Text="{x:Bind CountText}" />
                                    </TextBlock>
                                    <Rectangle
                                        Grid.Column="1"
                                        Height="1"
                                        VerticalAlignment="Center"
                                        Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                </Grid>
                            </DataTemplate>
                            <DataTemplate x:Key="ActivityFailedHeaderTemplate" x:DataType="models:ActivityHeader">
                                <Grid
                                    Margin="0,8,0,0"
                                    AutomationProperties.HeadingLevel="Level3"
                                    AutomationProperties.Name="{x:Bind AccessibleName}"
                                    ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}" Style="{StaticResource CaptionTextBlockStyle}">
                                        <Run FontWeight="SemiBold" Text="{x:Bind Name}" />
                                        <Run Text="{x:Bind CountText}" />
                                    </TextBlock>
                                    <Rectangle
                                        Grid.Column="1"
                                        Height="1"
                                        VerticalAlignment="Center"
                                        Fill="{ThemeResource SystemFillColorCriticalBrush}" />
                                </Grid>
                            </DataTemplate>
                            <DataTemplate x:Key="ActivityOperationTemplate" x:DataType="models:PackageOperation">
                                <controls:OperationCard Operation="{x:Bind}" />
                            </DataTemplate>
                            <controls:ActivityEntryTemplateSelector
                                x:Key="ActivityEntrySelector"
                                FailedHeader="{StaticResource ActivityFailedHeaderTemplate}"
                                Header="{StaticResource ActivityHeaderTemplate}"
                                Operation="{StaticResource ActivityOperationTemplate}" />
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock
                                AutomationProperties.HeadingLevel="Level2"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="Activity" />
                            <StackPanel
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="4">
                                <!-- 009 R4.5 -->
                                <DropDownButton
                                    AutomationProperties.Name="{x:Bind Activity.SortText, Mode=OneWay}"
                                    ToolTipService.ToolTip="{x:Bind Activity.SortText, Mode=OneWay}">
                                    <FontIcon FontSize="12" Glyph="&#xE8CB;" />
                                    <DropDownButton.Flyout>
                                        <MenuFlyout Opening="ActivitySort_Opening" Placement="BottomEdgeAlignedRight">
                                            <RadioMenuFlyoutItem Click="ActivitySort_Click" GroupName="ActivitySort" Tag="Default" Text="Default" />
                                            <RadioMenuFlyoutItem Click="ActivitySort_Click" GroupName="ActivitySort" Tag="Newest" Text="Newest first" />
                                            <RadioMenuFlyoutItem Click="ActivitySort_Click" GroupName="ActivitySort" Tag="Oldest" Text="Oldest first" />
                                            <RadioMenuFlyoutItem Click="ActivitySort_Click" GroupName="ActivitySort" Tag="Name" Text="Name A to Z" />
                                        </MenuFlyout>
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                                <Button Command="{x:Bind Activity.ClearFinishedCommand}" Content="Clear finished" />
                                <!-- 009 R3.1 -->
                                <ToggleButton
                                    AutomationProperties.Name="Pin the Activity pane"
                                    IsChecked="{x:Bind Activity.IsPinned, Mode=TwoWay}"
                                    ToolTipService.ToolTip="Keep Activity open beside the page">
                                    <FontIcon FontSize="12" Glyph="&#xE718;" />
                                </ToggleButton>
                                <!-- 009 R3.6: hidden while pinned -->
                                <Button
                                    AutomationProperties.Name="Close activity"
                                    Click="CloseActivity_Click"
                                    Visibility="{x:Bind ui:Ui.Collapsed(Activity.IsPinned), Mode=OneWay}">
                                    <FontIcon FontSize="12" Glyph="&#xE711;" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <!-- 009 R4.1; Esc clears it (R4.10) -->
                        <TextBox
                            Grid.Row="1"
                            AutomationProperties.Name="Filter activity by name or ID"
                            KeyDown="ActivityFilter_KeyDown"
                            PlaceholderText="Filter by name or ID"
                            Text="{x:Bind Activity.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <!-- 009 R4.2, R4.3 -->
                        <SelectorBar
                            x:Name="ActivityTabs"
                            Grid.Row="2"
                            AutomationProperties.Name="Show"
                            SelectionChanged="ActivityTabs_SelectionChanged">
                            <SelectorBarItem IsSelected="True" Tag="All" Text="{x:Bind Activity.AllTabText, Mode=OneWay}" />
                            <SelectorBarItem Tag="Active" Text="{x:Bind Activity.ActiveTabText, Mode=OneWay}" />
                            <SelectorBarItem Tag="Done" Text="{x:Bind Activity.DoneTabText, Mode=OneWay}" />
                            <SelectorBarItem Tag="Failed" Text="{x:Bind Activity.FailedTabText, Mode=OneWay}" />
                        </SelectorBar>
                        <TextBlock
                            Grid.Row="3"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Nothing yet. Installs, updates and uninstalls show up here."
                            TextWrapping="Wrap"
                            Visibility="{x:Bind Activity.IsEmpty, Mode=OneWay}" />
                        <!-- 009 R4.7 -->
                        <StackPanel
                            Grid.Row="3"
                            Spacing="4"
                            Visibility="{x:Bind Activity.HasNoMatch, Mode=OneWay}">
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="No operations match." />
                            <HyperlinkButton
                                Padding="0"
                                Command="{x:Bind Activity.ClearFilterCommand}"
                                Content="Clear filter" />
                        </StackPanel>
                        <ListView
                            Grid.Row="3"
                            AutomationProperties.Name="Operations"
                            ContainerContentChanging="ActivityList_ContainerContentChanging"
                            ItemTemplateSelector="{StaticResource ActivityEntrySelector}"
                            ItemsSource="{x:Bind Activity.Entries}"
                            SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </Grid>
                </SplitView.Pane>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <!-- 018 R1.1: Windows' permission prompt is waiting; it goes when the prompt does (R1.3) -->
                        <InfoBar
                            Margin="24,8,24,0"
                            AutomationProperties.LiveSetting="Assertive"
                            IsClosable="False"
                            IsOpen="{x:Bind Shell.IsPermissionBannerOpen, Mode=OneWay}"
                            Message="{x:Bind Shell.PermissionBannerMessage}"
                            Severity="Warning"
                            Title="{x:Bind Shell.PermissionBannerTitle}">
                            <InfoBar.IconSource>
                                <FontIconSource Glyph="&#xEA18;" />
                            </InfoBar.IconSource>
                        </InfoBar>
                        <!-- 003 R5.1–R5.3: outcome of the latest operation -->
                        <InfoBar
                            Margin="24,8,24,0"
                            CloseButtonCommand="{x:Bind Shell.CloseNotificationCommand}"
                            IsOpen="{x:Bind Shell.IsNotificationOpen, Mode=TwoWay}"
                            Message="{x:Bind Shell.NotificationMessage, Mode=OneWay}"
                            Severity="{x:Bind ui:Ui.Severity(Shell.NotificationSeverity), Mode=OneWay}"
                            Title="{x:Bind Shell.NotificationTitle, Mode=OneWay}">
                            <!-- 004 R6.3 -->
                            <InfoBar.ActionButton>
                                <Button
                                    Command="{x:Bind Shell.RestartCommand}"
                                    Content="Restart CartonStash"
                                    Visibility="{x:Bind Shell.HasNotificationRestart, Mode=OneWay}" />
                            </InfoBar.ActionButton>
                        </InfoBar>
                    </StackPanel>
                    <Frame x:Name="ContentFrame" Grid.Row="1" />
                </Grid>
            </SplitView>
        </NavigationView>
    </Grid>
</Window>
