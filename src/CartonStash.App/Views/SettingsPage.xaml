<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CartonStash.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:CartonStash.Core.Models"
    xmlns:ui="using:CartonStash.App"
    xmlns:vm="using:CartonStash.Core.ViewModels"
    NavigationCacheMode="Required">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Grid">
            <Setter Property="Padding" Value="16" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
            <Setter Property="ColumnSpacing" Value="16" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel
            MaxWidth="1000"
            Padding="24,16,24,24"
            HorizontalAlignment="Stretch"
            Spacing="8">
            <TextBlock
                Margin="0,0,0,12"
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Settings" />

            <!-- Appearance (R1.1) -->
            <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Appearance" />
            <Grid Style="{StaticResource CardStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Theme" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Applies immediately" />
                </StackPanel>
                <ComboBox
                    Grid.Column="1"
                    MinWidth="200"
                    AutomationProperties.Name="Theme"
                    SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                    <x:String>Use system setting</x:String>
                    <x:String>Light</x:String>
                    <x:String>Dark</x:String>
                </ComboBox>
            </Grid>

            <!-- Start page (R5.1, R5.3) -->
            <Grid Style="{StaticResource CardStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Start page" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Used the next time the app starts" />
                </StackPanel>
                <ComboBox
                    Grid.Column="1"
                    MinWidth="200"
                    AutomationProperties.Name="Start page"
                    SelectedIndex="{x:Bind ViewModel.StartPageIndex, Mode=TwoWay}">
                    <x:String>Search</x:String>
                    <x:String>Installed</x:String>
                    <x:String>Updates</x:String>
                </ComboBox>
            </Grid>

            <!-- Installing (R2.1, R2.2) -->
            <TextBlock Margin="0,12,0,0" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Installing" />
            <Grid Style="{StaticResource CardStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Default install scope" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Used for every install and update" />
                </StackPanel>
                <ComboBox
                    Grid.Column="1"
                    MinWidth="200"
                    AutomationProperties.Name="Default install scope"
                    SelectedIndex="{x:Bind ViewModel.ScopeIndex, Mode=TwoWay}">
                    <x:String>Let WinGet decide</x:String>
                    <x:String>Current user</x:String>
                    <x:String>All users (machine)</x:String>
                </ComboBox>
            </Grid>
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.ShowScopeWarning, Mode=OneWay}"
                Message="Installers for all users usually need administrator rights, so Windows may show a UAC prompt for each install."
                Severity="Informational" />

            <!-- Update checks (010 R3.1–R3.4, R3.8, R4.1) -->
            <TextBlock Margin="0,12,0,0" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Update checks" />
            <Grid Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <RadioButtons
                        AutomationProperties.Name="Background update checks"
                        Header="Background update checks"
                        IsEnabled="{x:Bind Checks.IsAvailable}"
                        SelectedIndex="{x:Bind Checks.ModeIndex, Mode=TwoWay}">
                        <x:String>Off</x:String>
                        <x:String>Every</x:String>
                        <x:String>Every day at</x:String>
                    </RadioButtons>
                    <ComboBox
                        MinWidth="200"
                        AutomationProperties.Name="Check every"
                        Header="Check every"
                        IsEnabled="{x:Bind Checks.IsIntervalMode, Mode=OneWay}"
                        SelectedIndex="{x:Bind Checks.IntervalIndex, Mode=TwoWay}">
                        <x:String>1 hour</x:String>
                        <x:String>6 hours</x:String>
                        <x:String>12 hours</x:String>
                        <x:String>24 hours</x:String>
                        <x:String>7 days</x:String>
                    </ComboBox>
                    <TimePicker
                        AutomationProperties.Name="Check every day at"
                        Header="Check every day at"
                        IsEnabled="{x:Bind Checks.IsDailyMode, Mode=OneWay}"
                        Time="{x:Bind Checks.CheckTime, Mode=TwoWay}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Windows decides the exact moment, so a check can start up to 15 minutes before the chosen time, or later than it. A check missed while the PC was off or asleep runs when you come back."
                        TextWrapping="Wrap" />
                    <TextBlock IsTextSelectionEnabled="True" Text="{x:Bind Checks.LastCheckText, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind Checks.NextCheckText, Mode=OneWay}"
                        Visibility="{x:Bind Checks.HasNextCheck, Mode=OneWay}" />
                </StackPanel>
            </Grid>
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind Checks.IsUnavailable}"
                Message="Background update checks need the Microsoft Store version of CartonStash."
                Severity="Informational" />
            <InfoBar
                Title="Windows isn't allowing background checks"
                IsClosable="False"
                IsOpen="{x:Bind Checks.IsBlocked, Mode=OneWay}"
                Message="Allow it in Windows Settings, under Apps, Installed apps, CartonStash, Advanced options, Background app permissions. Everything else keeps working."
                Severity="Warning" />
            <InfoBar
                Title="Windows won't start CartonStash at sign-in"
                IsClosable="False"
                IsOpen="{x:Bind Checks.IsStartupBlocked, Mode=OneWay}"
                Message="So a check missed while the PC was off waits until you unlock it. Turn on CartonStash update check in Windows Settings, under Apps, Startup."
                Severity="Informational" />

            <!-- Excluded packages (010 R5.4) -->
            <TextBlock Margin="0,12,0,0" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Excluded packages" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="No packages are excluded."
                Visibility="{x:Bind Checks.HasNoExcluded, Mode=OneWay}" />
            <ItemsControl ItemsSource="{x:Bind Checks.Excluded}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ExcludedPackageRow">
                        <Grid Margin="0,0,0,4" Style="{StaticResource CardStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Id}" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{x:Bind RemoveLabel}"
                                Click="RemoveExclusion_Click"
                                Content="Remove"
                                Tag="{x:Bind}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Check history (010 R3.11) -->
            <TextBlock Margin="0,12,0,0" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Check history" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="No checks in the last 7 days."
                Visibility="{x:Bind Checks.HasNoHistory, Mode=OneWay}" />
            <ItemsControl ItemsSource="{x:Bind Checks.History}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CheckHistoryRow">
                        <Grid Margin="0,0,0,4" Style="{StaticResource CardStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                AutomationProperties.Name="Failed"
                                FontSize="14"
                                Glyph="&#xE783;"
                                Visibility="{x:Bind IsFailed}" />
                            <TextBlock
                                Grid.Column="1"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind Text}"
                                TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Sources (R3.1–R3.3) -->
            <Grid Margin="0,12,0,0">
                <TextBlock
                    VerticalAlignment="Bottom"
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Sources" />
                <Button
                    HorizontalAlignment="Right"
                    Command="{x:Bind ViewModel.RefreshSourcesCommand}"
                    Content="Refresh sources"
                    IsEnabled="{x:Bind ui:Ui.Not(ViewModel.IsBusy), Mode=OneWay}" />
            </Grid>
            <ProgressBar
                AutomationProperties.Name="Refreshing sources"
                IsIndeterminate="True"
                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            <TextBlock
                AutomationProperties.LiveSetting="Polite"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.SourcesStatus, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HasSourcesStatus, Mode=OneWay}" />
            <InfoBar
                Title="Some sources couldn't be refreshed"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasSourcesError, Mode=OneWay}"
                Message="{x:Bind ViewModel.SourcesError, Mode=OneWay}"
                Severity="Warning" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Sources}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:SourceInfo">
                        <Grid Margin="0,0,0,4" Style="{StaticResource CardStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    IsTextSelectionEnabled="True"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind DetailText}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Right" Text="{x:Bind TrustText}" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind LastUpdatedText}" />
                            </StackPanel>
                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{x:Bind ui:Ui.Format('Review agreements for {0}', Name)}"
                                Click="ReviewAgreements_Click"
                                Content="{x:Bind AgreementButtonText}"
                                Tag="{x:Bind}"
                                Visibility="{x:Bind HasAgreements}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- About (R4.1, R4.2) -->
            <TextBlock Margin="0,12,0,0" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource BodyStrongTextBlockStyle}" Text="About" />
            <Grid Style="{StaticResource CardStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    IsTextSelectionEnabled="True"
                    Text="{x:Bind ViewModel.VersionText, Mode=OneWay}" />
                <Button
                    Grid.Column="1"
                    Command="{x:Bind ViewModel.CopyDiagnosticsCommand}"
                    Content="Copy diagnostic info" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
