<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CartonStash.App.Views.UpdatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CartonStash.App.Controls"
    xmlns:ui="using:CartonStash.App"
    xmlns:vm="using:CartonStash.Core.ViewModels"
    NavigationCacheMode="Required">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid Padding="24,16,24,0" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.Title, Mode=OneWay}" />
                <!-- R2.2 -->
                <Button
                    Grid.Column="1"
                    Command="{x:Bind ViewModel.UpdateSelectedCommand}"
                    Content="Update selected" />
                <!-- R2.3 -->
                <Button
                    Grid.Column="2"
                    Command="{x:Bind ViewModel.UpdateAllCommand}"
                    Content="Update all"
                    IsEnabled="{x:Bind ui:Ui.Not(ViewModel.IsUpToDate), Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button
                    Grid.Column="3"
                    AutomationProperties.Name="Refresh"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    ToolTipService.ToolTip="Refresh">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                </Button>
            </Grid>

            <StackPanel Grid.Row="1" Spacing="8">
                <ProgressBar
                    AutomationProperties.Name="Checking for updates"
                    IsIndeterminate="True"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                <InfoBar
                    Title="Couldn't check for updates"
                    IsClosable="False"
                    IsOpen="{x:Bind ui:Ui.HasText(ViewModel.ErrorMessage), Mode=OneWay}"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Severity="Error">
                    <InfoBar.ActionButton>
                        <Button Command="{x:Bind ViewModel.RefreshCommand}" Content="Retry" />
                    </InfoBar.ActionButton>
                </InfoBar>
            </StackPanel>

            <Grid Grid.Row="2">
                <!-- R1.1, R2.2: checkboxes select; clicking a row opens details (005) -->
                <ListView
                    x:Name="UpdatesList"
                    AutomationProperties.Name="Available updates"
                    ItemsSource="{x:Bind ViewModel.Updates}"
                    SelectionChanged="UpdatesList_SelectionChanged"
                    SelectionMode="Multiple">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:PackageRowViewModel">
                            <controls:PackageRow AutomationProperties.Name="{x:Bind Name}" Row="{x:Bind}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- R5.1 -->
                <StackPanel
                    Margin="0,48,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.IsUpToDate, Mode=OneWay}">
                    <FontIcon
                        HorizontalAlignment="Center"
                        FontSize="32"
                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                        Glyph="&#xE73E;" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Everything is up to date" />
                </StackPanel>
            </Grid>
        </Grid>

        <controls:PackageDetailsPane
            x:Name="DetailsPane"
            Grid.Column="1"
            Width="380"
            ViewModel="{x:Bind ViewModel.Details}"
            Visibility="{x:Bind ViewModel.Details.IsOpen, Mode=OneWay}" />
    </Grid>
</Page>
