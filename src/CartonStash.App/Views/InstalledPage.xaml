<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CartonStash.App.Views.InstalledPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CartonStash.App.Controls"
    xmlns:ui="using:CartonStash.App"
    xmlns:vm="using:CartonStash.Core.ViewModels"
    NavigationCacheMode="Required">

    <Page.Resources>
        <ResourceDictionary>
            <!-- 002 R8: a selected chip is shown with a neutral fill and outline, not the accent color, so the
                 colored dots stay the only color cue (the accent could be green, blue or amber itself).
                 Per-theme dictionaries so the referenced brushes follow light / dark / high contrast. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="SubtleFillColorTertiaryBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                    <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="TextFillColorPrimaryBrush" />
                    <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
                    <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="TextFillColorSecondaryBrush" />
                    <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="TextFillColorPrimaryBrush" />
                    <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
                    <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="TextFillColorSecondaryBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="SubtleFillColorTertiaryBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                    <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="TextFillColorPrimaryBrush" />
                    <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
                    <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="TextFillColorSecondaryBrush" />
                    <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="TextFillColorPrimaryBrush" />
                    <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
                    <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="TextFillColorSecondaryBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="SystemColorHighlightColorBrush" />
                    <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="SystemColorHighlightTextColorBrush" />
                    <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="SystemColorHighlightTextColorBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- 002 R8: pill-shaped toggle chips -->
            <Style x:Key="ChipStyle" BasedOn="{StaticResource DefaultToggleButtonStyle}" TargetType="ToggleButton">
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="12,4" />
                <Setter Property="MinHeight" Value="28" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid Padding="24,16,24,0" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <TextBlock
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Installed" />
                <!-- R1.3 -->
                <Button HorizontalAlignment="Right" Command="{x:Bind ViewModel.RefreshCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid
                Grid.Row="1"
                ColumnSpacing="12"
                RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- R2.1 -->
                <TextBox
                    MinWidth="160"
                    AutomationProperties.Name="Filter installed packages"
                    PlaceholderText="Filter by name or ID"
                    Text="{x:Bind ViewModel.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <!-- R2.2 -->
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.LiveSetting="Polite"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.CountText, Mode=OneWay}" />
                <!-- 002 R8: status chips, also the legend for the badge colors (R7) -->
                <ScrollViewer
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Auto"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled">
                    <StackPanel
                        AutomationProperties.Name="Filter by version status"
                        Orientation="Horizontal"
                        Spacing="8">
                    <ToggleButton
                        AutomationProperties.Name="All statuses"
                        Content="All"
                        IsChecked="{x:Bind ViewModel.IsAllSelected, Mode=TwoWay}"
                        Style="{StaticResource ChipStyle}" />
                    <ToggleButton
                        AutomationProperties.Name="{x:Bind ui:Ui.Chip('Up to date', ViewModel.SameCount, 'Same version as the source'), Mode=OneWay}"
                        IsChecked="{x:Bind ViewModel.IsSameSelected, Mode=TwoWay}"
                        Opacity="{x:Bind ui:Ui.DimIfZero(ViewModel.SameCount), Mode=OneWay}"
                        Style="{StaticResource ChipStyle}"
                        ToolTipService.ToolTip="{x:Bind ui:Ui.Chip('Up to date', ViewModel.SameCount, 'Same version as the source'), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                            <TextBlock Text="Up to date" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.SameCount, Mode=OneWay}" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton
                        AutomationProperties.Name="{x:Bind ui:Ui.Chip('Update available', ViewModel.UpdateCount, 'Older, and WinGet offers an update'), Mode=OneWay}"
                        IsChecked="{x:Bind ViewModel.IsUpdateSelected, Mode=TwoWay}"
                        Opacity="{x:Bind ui:Ui.DimIfZero(ViewModel.UpdateCount), Mode=OneWay}"
                        Style="{StaticResource ChipStyle}"
                        ToolTipService.ToolTip="{x:Bind ui:Ui.Chip('Update available', ViewModel.UpdateCount, 'Older, and WinGet offers an update'), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{ThemeResource SystemFillColorCautionBrush}" />
                            <TextBlock Text="Update available" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.UpdateCount, Mode=OneWay}" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton
                        AutomationProperties.Name="{x:Bind ui:Ui.Chip('Newer', ViewModel.NewerCount, 'Newer than the version the source offers'), Mode=OneWay}"
                        IsChecked="{x:Bind ViewModel.IsNewerSelected, Mode=TwoWay}"
                        Opacity="{x:Bind ui:Ui.DimIfZero(ViewModel.NewerCount), Mode=OneWay}"
                        Style="{StaticResource ChipStyle}"
                        ToolTipService.ToolTip="{x:Bind ui:Ui.Chip('Newer', ViewModel.NewerCount, 'Newer than the version the source offers'), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{ThemeResource VersionNewerBorderBrush}" />
                            <TextBlock Text="Newer" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.NewerCount, Mode=OneWay}" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton
                        AutomationProperties.Name="{x:Bind ui:Ui.Chip('Other', ViewModel.OtherCount, 'Not managed by WinGet, or WinGet cannot compare the versions'), Mode=OneWay}"
                        IsChecked="{x:Bind ViewModel.IsOtherSelected, Mode=TwoWay}"
                        Opacity="{x:Bind ui:Ui.DimIfZero(ViewModel.OtherCount), Mode=OneWay}"
                        Style="{StaticResource ChipStyle}"
                        ToolTipService.ToolTip="{x:Bind ui:Ui.Chip('Other', ViewModel.OtherCount, 'Not managed by WinGet, or WinGet cannot compare the versions'), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
                            <TextBlock Text="Other" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.OtherCount, Mode=OneWay}" />
                        </StackPanel>
                    </ToggleButton>
                    </StackPanel>
                </ScrollViewer>
                <!-- R2.4 -->
                <CheckBox
                    Grid.Row="2"
                    Grid.ColumnSpan="2"
                    Content="Show apps not managed by WinGet"
                    IsChecked="{x:Bind ViewModel.ShowUnmanaged, Mode=TwoWay}" />
            </Grid>

            <StackPanel Grid.Row="2" Spacing="8">
                <!-- R1.4 -->
                <ProgressBar
                    AutomationProperties.Name="Loading installed packages"
                    IsIndeterminate="True"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                <!-- R5.1 -->
                <InfoBar
                    Title="Couldn't load installed packages"
                    IsClosable="False"
                    IsOpen="{x:Bind ui:Ui.HasText(ViewModel.ErrorMessage), Mode=OneWay}"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Severity="Error">
                    <InfoBar.ActionButton>
                        <Button Command="{x:Bind ViewModel.RefreshCommand}" Content="Retry" />
                    </InfoBar.ActionButton>
                </InfoBar>
            </StackPanel>

            <ListView
                x:Name="PackagesList"
                Grid.Row="3"
                AutomationProperties.Name="Installed packages"
                ItemsSource="{x:Bind ViewModel.Visible}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PackageRowViewModel">
                        <controls:PackageRow AutomationProperties.Name="{x:Bind Name}" Row="{x:Bind}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <controls:PackageDetailsPane
            x:Name="DetailsPane"
            Grid.Column="1"
            Width="380"
            ViewModel="{x:Bind ViewModel.Details}"
            Visibility="{x:Bind ViewModel.Details.IsOpen, Mode=OneWay}" />
    </Grid>
</Page>
