<?xml version="1.0" encoding="utf-8"?>
<!-- One package row, shared by Search, Installed and Updates (002 T5). -->
<UserControl
    x:Class="WinGetFrontend.App.Controls.PackageRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinGetFrontend.App.Controls"
    xmlns:ui="using:WinGetFrontend.App">

    <Grid Padding="0,8" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="32" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="200" />
        </Grid.ColumnDefinitions>

        <!-- 005 R5.1: WinGet's icon, or a package glyph -->
        <Grid Width="32" Height="32" VerticalAlignment="Center">
            <FontIcon
                FontSize="22"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xE7B8;"
                Visibility="{x:Bind ui:Ui.Collapsed(Row.HasIcon), Mode=OneWay}" />
            <Image
                AutomationProperties.AccessibilityView="Raw"
                Source="{x:Bind ui:Ui.Icon(Row.IconUri, 32), Mode=OneWay}"
                Stretch="Uniform" />
        </Grid>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind Row.Name, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind Row.Id, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <StackPanel
            Grid.Column="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Spacing="4">
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <!-- 001 R2.1 -->
                <Border
                    Padding="6,1"
                    Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                    BorderBrush="{ThemeResource SystemFillColorSuccessBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="{x:Bind Row.Package.IsInstalled, Mode=OneWay}">
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}">
                        <Run Text="Installed" />
                        <Run Text="{x:Bind Row.Package.InstalledVersion, Mode=OneWay}" />
                    </TextBlock>
                </Border>
                <!-- 001 R2.2, 002 R3.2 -->
                <Border
                    Padding="6,1"
                    Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                    BorderBrush="{ThemeResource SystemFillColorAttentionBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="{x:Bind Row.Package.HasUpdate, Mode=OneWay}">
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Update available" />
                </Border>
                <TextBlock HorizontalAlignment="Right" Text="{x:Bind Row.Package.AvailableVersion, Mode=OneWay}" />
            </StackPanel>
            <!-- 002 R1.2, R3.1 -->
            <TextBlock
                HorizontalAlignment="Right"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="{x:Bind Row.Package.SourceText, Mode=OneWay}" />
        </StackPanel>

        <controls:PackageActionsView Grid.Column="3" Row="{x:Bind Row, Mode=OneWay}" />
    </Grid>
</UserControl>
