<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinGetFrontend.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WinGetFrontend.Core.Models"
    xmlns:ui="using:WinGetFrontend.App"
    Title="WinGet Frontend">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Padding="16,0,0,0">
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="WinGet Frontend" />
        </Grid>

        <!-- 002 R4.1: left navigation. Pages are cached for the session (R4.2). -->
        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="True"
            IsSettingsVisible="True"
            ItemInvoked="Nav_ItemInvoked"
            OpenPaneLength="220"
            PaneDisplayMode="Left"
            SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Search" Tag="search">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Installed" Tag="installed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7B8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!-- 004 R4.1 -->
                <NavigationViewItem Content="Updates" Tag="updates">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE777;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge
                            AutomationProperties.Name="Available updates"
                            Visibility="{x:Bind Shell.HasUpdates, Mode=OneWay}"
                            Value="{x:Bind Shell.UpdatesCount, Mode=OneWay}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <!-- 003: opens the Activity pane instead of navigating (see Nav_SelectionChanged) -->
                <NavigationViewItem
                    Content="{x:Bind Shell.ActivityText, Mode=OneWay}"
                    Tag="activity">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <SplitView
                x:Name="ActivitySplit"
                DisplayMode="Overlay"
                OpenPaneLength="400"
                PaneBackground="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                PanePlacement="Right">
                <SplitView.Pane>
                    <Grid Padding="16" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock
                                AutomationProperties.HeadingLevel="Level2"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="Activity" />
                            <StackPanel
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="4">
                                <Button Command="{x:Bind Activity.ClearFinishedCommand}" Content="Clear finished" />
                                <Button AutomationProperties.Name="Close activity" Click="CloseActivity_Click">
                                    <FontIcon FontSize="12" Glyph="&#xE711;" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <TextBlock
                            Grid.Row="1"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Nothing yet. Installs, updates and uninstalls show up here."
                            TextWrapping="Wrap"
                            Visibility="{x:Bind Activity.IsEmpty, Mode=OneWay}" />
                        <ListView
                            Grid.Row="1"
                            AutomationProperties.Name="Operations"
                            ItemsSource="{x:Bind Activity.Operations}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:PackageOperation">
                                    <Grid
                                        Padding="0,8"
                                        AutomationProperties.Name="{x:Bind Title}"
                                        ColumnSpacing="8"
                                        RowSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind Title}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Text="{x:Bind StatusText, Mode=OneWay}" />
                                        <ProgressBar
                                            Grid.Row="2"
                                            AutomationProperties.Name="{x:Bind StatusText, Mode=OneWay}"
                                            IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                                            Maximum="100"
                                            Visibility="{x:Bind IsActive, Mode=OneWay}"
                                            Value="{x:Bind ProgressValue, Mode=OneWay}" />
                                        <TextBlock
                                            Grid.Row="2"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Message, Mode=OneWay}"
                                            TextWrapping="Wrap"
                                            Visibility="{x:Bind ui:Ui.Collapsed(IsActive), Mode=OneWay}" />
                                        <StackPanel
                                            Grid.RowSpan="3"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="4">
                                            <Button
                                                AutomationProperties.Name="{x:Bind ui:Ui.Format('Cancel {0}', Title)}"
                                                Command="{x:Bind CancelCommand}"
                                                Content="Cancel"
                                                Visibility="{x:Bind CanCancel, Mode=OneWay}" />
                                            <!-- 003 R5.2 -->
                                            <Button
                                                AutomationProperties.Name="{x:Bind ui:Ui.Format('Retry {0}', Title)}"
                                                Command="{x:Bind RetryCommand}"
                                                Content="Retry"
                                                Visibility="{x:Bind CanRetry, Mode=OneWay}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </SplitView.Pane>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- 003 R5.1–R5.3: outcome of the latest operation -->
                    <InfoBar
                        Margin="24,8,24,0"
                        CloseButtonCommand="{x:Bind Shell.CloseNotificationCommand}"
                        IsOpen="{x:Bind Shell.IsNotificationOpen, Mode=TwoWay}"
                        Message="{x:Bind Shell.NotificationMessage, Mode=OneWay}"
                        Severity="{x:Bind ui:Ui.Severity(Shell.NotificationSeverity), Mode=OneWay}"
                        Title="{x:Bind Shell.NotificationTitle, Mode=OneWay}" />
                    <Frame x:Name="ContentFrame" Grid.Row="1" />
                </Grid>
            </SplitView>
        </NavigationView>
    </Grid>
</Window>
