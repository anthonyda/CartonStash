<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinGetFrontend.App.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinGetFrontend.App.Controls"
    xmlns:ui="using:WinGetFrontend.App"
    xmlns:vm="using:WinGetFrontend.Core.ViewModels"
    NavigationCacheMode="Required">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid Padding="24,16,24,0" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Search packages" />

            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="QueryBox"
                    AutomationProperties.Name="Search packages"
                    KeyDown="QueryBox_KeyDown"
                    PlaceholderText="Name, ID or moniker (e.g. git, vscode, 7zip)"
                    TabIndex="0"
                    Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Grid.Column="1"
                    Command="{x:Bind ViewModel.SearchCommand}"
                    Content="Search"
                    Style="{StaticResource AccentButtonStyle}"
                    TabIndex="1" />
            </Grid>

            <StackPanel Grid.Row="2" Spacing="8">
                <ProgressBar
                    AutomationProperties.Name="Searching"
                    IsIndeterminate="True"
                    Visibility="{x:Bind ViewModel.IsSearching, Mode=OneWay}" />
                <InfoBar
                    Title="Search failed"
                    IsClosable="False"
                    IsOpen="{x:Bind ui:Ui.HasText(ViewModel.ErrorMessage), Mode=OneWay}"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Severity="Error" />
            </StackPanel>

            <Grid Grid.Row="3">
                <ListView
                    x:Name="ResultsList"
                    AutomationProperties.Name="Search results"
                    ItemsSource="{x:Bind ViewModel.Results}"
                    SelectionMode="None"
                    TabIndex="2">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:PackageRowViewModel">
                            <controls:PackageRow AutomationProperties.Name="{x:Bind Name}" Row="{x:Bind}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- 001 R3.3 -->
                <TextBlock
                    Margin="0,48,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}"
                    Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.EmptyMessage), Mode=OneWay}" />
            </Grid>
        </Grid>

        <controls:PackageDetailsPane
            x:Name="DetailsPane"
            Grid.Column="1"
            Width="380"
            ViewModel="{x:Bind ViewModel.Details}"
            Visibility="{x:Bind ViewModel.Details.IsOpen, Mode=OneWay}" />
    </Grid>
</Page>
