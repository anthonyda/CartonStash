<?xml version="1.0" encoding="utf-8"?>
<!-- Spec 007 R5.12: packages come from nuget.org only, whatever feeds this machine has configured. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
