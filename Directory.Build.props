<Project>
  <!-- Shared settings for every project in the solution. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- WinGet's COM interop and the Windows App SDK both need a concrete architecture.
         Default to the machine's own (win-x64 / win-arm64); override with -r. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <SelfContained>false</SelfContained>

    <!-- Spec 007 R5.12: one lock file covers both architectures; CI refuses a restore that doesn't match it. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>

    <!-- GitHub's automatic dependency submission restores on Linux, which refuses Windows targets without this (NETSDK1100). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>
